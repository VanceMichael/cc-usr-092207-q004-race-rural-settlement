{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "山野赛事惠农结算共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "processes",
    "scenarios",
    "invariants",
    "reports"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "processes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "states", "transitions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string" }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["from", "to", "on"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "on": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "trigger", "refund_routing"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "rule": { "type": "string" },
          "refund_routing": {
            "type": "object",
            "required": ["self_paid", "subsidy"],
            "properties": {
              "self_paid": { "type": "string", "minLength": 1 },
              "subsidy": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
