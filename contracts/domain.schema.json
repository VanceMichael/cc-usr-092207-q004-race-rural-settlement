{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "山野赛事惠农结算共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "event",
    "actors",
    "facts",
    "constraints",
    "ledger_chain",
    "scenarios",
    "controls",
    "access_rules",
    "reports"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "ledger_chain": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/chainLink" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/scenario" }
    },
    "controls": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/control" }
    },
    "access_rules": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/accessRule" }
    },
    "reports": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/report" }
    }
  },
  "$defs": {
    "chainLink": {
      "type": "object",
      "required": ["id", "name", "desc"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "desc": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["id", "name", "trigger", "rule", "bearer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "bearer": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "accessRule": {
      "type": "object",
      "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["id", "question", "basis"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
